# research-os-dashboard — disposable local HTTP client.
# Does not own supervisors, lease, Preflight authority, or research decisions.
# Requires RESEARCH_OSD_URL in EnvironmentFile (http://127.0.0.1:8766).

[Unit]
Description=Research OS local operator dashboard
Documentation=file:///opt/research-os/current/docs/deploy/NATIVE_UBUNTU_SYSTEMD.md
After=network-online.target research-osd.service
Wants=research-osd.service
# Wants, not Requires: dashboard death must not stop research-osd.

[Service]
Type=simple
User=research-os
Group=research-os
WorkingDirectory=/opt/research-os/current
EnvironmentFile=/etc/research-os/research-os.env
Environment=HOME=/var/lib/research-os
ExecStart=/opt/research-os/current/.venv/bin/research-os-dashboard --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-os-dashboard

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/research-os /var/log/research-os
UMask=0027

[Install]
WantedBy=multi-user.target

{
  "capability_id": "http.authentication",
  "version": "1",
  "implementation_reference": "http.authentication",
  "executor_class": "WORKER",
  "actions": {
    "login": {
      "action_id": "login",
      "argument_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorized_origin",
          "path",
          "username",
          "username_field",
          "password_secret_name",
          "session_cookie_name",
          "session_context_id"
        ],
        "properties": {
          "authorized_origin": { "type": "string", "minLength": 1, "maxLength": 256 },
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "username": { "type": "string", "minLength": 1, "maxLength": 128 },
          "username_field": { "type": "string", "minLength": 1, "maxLength": 64 },
          "password_secret_name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "session_cookie_name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "session_context_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "identity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "success_status_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 100, "maximum": 599 }
          },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 2000 },
          "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 }
        }
      },
      "result_schema": { "type": "object", "additionalProperties": true },
      "minimum_side_effect_level": 1,
      "maximum_side_effect_level": 1,
      "target_types": ["opaque_reference"],
      "network_policy": {
        "allowed_methods": ["POST"],
        "max_requests": 1,
        "redirect": "STOP",
        "loopback_only": true
      },
      "requirements": ["loopback"],
      "supports_reproduction": true,
      "supports_negative_control": false,
      "normalizer_reference": "platform.url_normalize.v1"
    }
  }
}

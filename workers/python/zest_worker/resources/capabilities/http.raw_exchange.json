{
  "capability_id": "http.raw_exchange",
  "version": "1",
  "implementation_reference": "http.raw_exchange",
  "executor_class": "WORKER",
  "actions": {
    "probe": {
      "action_id": "probe",
      "argument_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorized_origin", "path", "framing_profile", "control", "lane"],
        "properties": {
          "authorized_origin": { "type": "string", "minLength": 1, "maxLength": 256 },
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "framing_profile": {
            "type": "string",
            "enum": [
              "http1_canonical",
              "http1_header_case_fold",
              "http1_absolute_uri",
              "http1_cl_te",
              "http1_te_cl",
              "http1_connection_reuse",
              "http2_preface",
              "h2c_upgrade",
              "http1_cache_host",
              "http1_cache_scheme",
              "http1_cache_path",
              "http1_cache_query",
              "http1_cache_header"
            ]
          },
          "control": { "type": "string", "minLength": 1, "maxLength": 64 },
          "lane": {
            "type": "string",
            "enum": [
              "http_request_smuggling_desync",
              "http_cache_poisoning_deception"
            ]
          },
          "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      },
      "result_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "minimum_side_effect_level": 0,
      "maximum_side_effect_level": 0,
      "target_types": ["opaque_reference"],
      "network_policy": {
        "allowed_methods": ["RAW"],
        "max_requests": 2,
        "redirect": "STOP",
        "loopback_only": true
      },
      "requirements": ["loopback"],
      "supports_reproduction": true,
      "supports_negative_control": true,
      "normalizer_reference": "platform.url_normalize.v1"
    }
  }
}

# Zest zestd operational config (example).
# Copy to /etc/zest/zest.env on the VDS. Do not commit secrets.
#
# Linux layout:
#   /opt/zest/releases/<immutable-release-id>/
#   /opt/zest/current -> releases/<immutable-release-id>
#   /etc/zest/zest.env
#   /var/lib/zest/
#   /var/log/zest/
#
# Bind stays 127.0.0.1. Do not set a public wildcard bind. This checkpoint does not add
# public TLS, VPN, reverse proxy, or remote operator access.
# Optional Alembic path if WorkingDirectory is not the source release:
# ZEST_ALEMBIC_INI=/opt/zest/current/alembic.ini

ZEST_DATABASE_URL=postgresql+psycopg://zest@127.0.0.1:5432/zest
ZEST_BIND_HOST=127.0.0.1
ZEST_API_PORT=8766
ZEST_HEARTBEAT_INTERVAL_SECONDS=30
ZEST_LEASE_TTL_SECONDS=90
ZEST_ENVIRONMENT_NAME=staging
ZEST_RELEASE_VERSION=phase-j.1
ZEST_URL=http://127.0.0.1:8766
ZEST_MODEL_RUNTIME_REF=codex.cli
ZEST_WORKER_RUNTIME_REF=persistent-browser
# Leave unset to use journald as the process log.
# ZEST_LOG_PATH=/var/log/zest/zestd.log

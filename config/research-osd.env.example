# Research OS research-osd operational config (example).
# Copy to /etc/research-os/research-os.env on the VDS. Do not commit secrets.
#
# Linux layout:
#   /opt/research-os/releases/<immutable-release-id>/
#   /opt/research-os/current -> releases/<immutable-release-id>
#   /etc/research-os/research-os.env
#   /var/lib/research-os/
#   /var/log/research-os/
#
# Bind stays 127.0.0.1. Do not set a public wildcard bind. This checkpoint does not add
# public TLS, VPN, reverse proxy, or remote operator access.
# Optional Alembic path if WorkingDirectory is not the source release:
# RESEARCH_OS_ALEMBIC_INI=/opt/research-os/current/alembic.ini

RESEARCH_OS_DATABASE_URL=postgresql+psycopg://research_os@127.0.0.1:5432/research_os
RESEARCH_OSD_BIND_HOST=127.0.0.1
RESEARCH_OSD_API_PORT=8766
RESEARCH_OSD_HEARTBEAT_INTERVAL_SECONDS=30
RESEARCH_OSD_LEASE_TTL_SECONDS=90
RESEARCH_OSD_ENVIRONMENT_NAME=staging
RESEARCH_OSD_RELEASE_VERSION=phase-j.1
RESEARCH_OSD_URL=http://127.0.0.1:8766
RESEARCH_OSD_MODEL_RUNTIME_REF=codex.cli
RESEARCH_OSD_WORKER_RUNTIME_REF=persistent-browser
# Leave unset to use journald as the process log.
# RESEARCH_OSD_LOG_PATH=/var/log/research-os/research-osd.log

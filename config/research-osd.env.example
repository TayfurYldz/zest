# Research OS research-osd operational config (example).
# Copy to /etc/research-os/research-osd.env on VDS. Do not commit secrets.
#
# Linux layout (Checkpoint 16 will install units; this file is portable now):
#   /opt/research-os/
#   /etc/research-os/
#   /var/lib/research-os/
#   /var/log/research-os/
#
# Bind stays loopback until Checkpoint 16 adds VPN/reverse-proxy auth.

RESEARCH_OS_DATABASE_URL=postgresql+psycopg://research_os@127.0.0.1:5432/research_os
RESEARCH_OSD_BIND_HOST=127.0.0.1
RESEARCH_OSD_API_PORT=8766
RESEARCH_OSD_HEARTBEAT_INTERVAL_SECONDS=30
RESEARCH_OSD_LEASE_TTL_SECONDS=90
RESEARCH_OSD_ENVIRONMENT_NAME=staging
RESEARCH_OSD_RELEASE_VERSION=phase-j.1
RESEARCH_OSD_LOG_PATH=/var/log/research-os/research-osd.log
RESEARCH_OSD_MODEL_RUNTIME_REF=codex.cli
RESEARCH_OSD_WORKER_RUNTIME_REF=persistent-browser
